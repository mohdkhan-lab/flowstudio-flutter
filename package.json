{
  "author": "FlowStudio",
  "dependencies": {
    "puppeteer-core": "^23.11.1",
    "sql.js": "^1.14.2",
    "electron-updater": "^6.3.9"
  },
  "description": "FlowStudio - simple multi-account Google Flow video generator",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "license": "ISC",
  "name": "flowstudio",
  "scripts": {
    "start": "electron main.js",
    "test": "node test_js/run_root_pack_tests.js",
    "dist": "electron-builder --win nsis",
    "test:smoke": "node test_js/run_project_smoke.js"
  },
  "version": "1.0.17",
  "build": {
    "appId": "com.mk.flowstudio",
    "productName": "FlowStudio",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "engine/**",
      "renderer/**",
      "node_modules/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FlowStudio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
